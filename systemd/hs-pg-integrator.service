[Unit]
Description=Restore HS Plugin integration after PasarGuard updates
After=docker.service network-online.target
Wants=network-online.target
[Service]
Type=oneshot
ExecStart=/bin/bash /opt/hs-pg/plugin/integrate-guard.sh
TimeoutStartSec=180
Nice=10
User=root
Group=root
[Install]
WantedBy=multi-user.target
