#!/usr/bin/env bash
set -Eeuo pipefail
ROOT="${HS_ROOT:-/opt/hs-pg}"
DATA="${HS_PLUGIN_DATA_DIR:-/var/lib/pasarguard/hs-plugin}"
cmd="${1:-status}"

rearm_guard(){
  command -v systemctl >/dev/null 2>&1 || return 0
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl enable hs-pg-integrator.timer >/dev/null 2>&1 || true
  systemctl restart hs-pg-integrator.timer >/dev/null 2>&1 || true
  systemctl restart hs-pg-integrator.service >/dev/null 2>&1 || true
}

case "$cmd" in
  apply|integrate)
    exec "$ROOT/plugin/integrate-dashboard.sh"
    ;;
  restart|restart-backend)
    "$ROOT/plugin/integrate-dashboard.sh"
    if command -v pasarguard >/dev/null 2>&1; then
      echo "[HS Plugin] restarting PasarGuard through the official CLI"
      pasarguard restart
      rearm_guard
      echo "[HS Plugin] persistence guard re-armed after restart"
    else
      echo "[HS Plugin] official pasarguard CLI was not found; refusing raw Docker lifecycle fallback" >&2
      exit 1
    fi
    ;;
  status)
    echo "HS Plugin root: $ROOT"
    echo "State: $DATA/state.json"
    [[ -f "$DATA/state.json" ]] && cat "$DATA/state.json" || echo '{"status":"not configured yet"}'
    if command -v systemctl >/dev/null 2>&1; then
      systemctl is-active hs-pg-integrator.service >/dev/null 2>&1 && echo 'Persistence guard: active' || echo 'Persistence guard: inactive'
      systemctl is-enabled hs-pg-integrator.timer >/dev/null 2>&1 && echo 'Self-heal timer: enabled' || echo 'Self-heal timer: not enabled'
    fi
    ;;
  update)
    command -v curl >/dev/null 2>&1 || { echo "[HS Plugin] curl is required for update" >&2; exit 1; }
    tmp="$(mktemp /tmp/hs-pg-update.XXXXXX.sh)"
    trap 'rm -f "$tmp"' EXIT
    curl -fL --show-error --retry 3 --connect-timeout 15 --max-time 120 -H 'Cache-Control: no-cache' \
      "https://raw.githubusercontent.com/PEDIHS/HS-PG/main/install.sh?update=$(date +%s)" -o "$tmp"
    bash "$tmp" --update
    rearm_guard
    echo "[HS Plugin] update complete; persistence guard active"
    ;;
  *)
    echo "Usage: hs-pg {status|apply|restart|update}" >&2; exit 2
    ;;
esac
